{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShowmarkHsu/NHITW_cloud_analyzer_react_MUI/blob/main/docs/upstream-sync/baseline.schema.json",
  "title": "NIHCloudAI upstream baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "capturedAt", "product", "upstream", "nicloudaiSource", "remoteTopology"],
  "properties": {
    "$schema": {"const": "./baseline.schema.json"},
    "schemaVersion": {"const": 1},
    "capturedAt": {"type": "string", "format": "date"},
    "product": {"$ref": "#/$defs/product"},
    "upstream": {"$ref": "#/$defs/upstream"},
    "nicloudaiSource": {"$ref": "#/$defs/source"},
    "remoteTopology": {"$ref": "#/$defs/remoteTopology"}
  },
  "$defs": {
    "gitUrl": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repositoryTarget"],
      "properties": {
        "name": {"const": "NIHCloudAI"},
        "repositoryTarget": {"$ref": "#/$defs/gitUrl"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "version", "license"],
      "properties": {
        "repository": {"$ref": "#/$defs/gitUrl"},
        "commit": {"$ref": "#/$defs/sha"},
        "version": {"type": "string", "minLength": 1},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "path", "sha256"],
          "properties": {
            "spdx": {"const": "Apache-2.0"},
            "path": {"const": "LICENSE"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"$ref": "#/$defs/gitUrl"},
        "commit": {"$ref": "#/$defs/sha"}
      }
    },
    "remoteRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "configured", "readable", "writable", "note"],
      "properties": {
        "repository": {"$ref": "#/$defs/gitUrl"},
        "configured": {"type": "boolean"},
        "readable": {"type": "boolean"},
        "writable": {"type": "boolean"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "remoteTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verificationStatus", "checkedAt", "roles"],
      "properties": {
        "verificationStatus": {
          "enum": ["verified", "blocked-final-fork-unavailable", "blocked-final-fork-permission"]
        },
        "checkedAt": {"type": "string", "format": "date"},
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "upstream", "nicloudai"],
          "properties": {
            "origin": {"$ref": "#/$defs/remoteRole"},
            "upstream": {"$ref": "#/$defs/remoteRole"},
            "nicloudai": {"$ref": "#/$defs/remoteRole"}
          }
        }
      }
    }
  }
}
