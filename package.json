{
  "name": "nhitw-cloud-analyzer",
  "version": "26.0702.1",
  "description": "NIHCloudAI - based on NHITW Cloud Analyzer (更好的健保雲端 2.0)",
  "license": "Apache-2.0",
  "author": "The NHITW Cloud Analyzer Project Authors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShowmarkHsu/NHITW_cloud_analyzer_react_MUI.git"
  },
  "bugs": {
    "url": "https://github.com/ShowmarkHsu/NHITW_cloud_analyzer_react_MUI/issues"
  },
  "homepage": "https://github.com/ShowmarkHsu/NHITW_cloud_analyzer_react_MUI",
  "private": true,
  "type": "module",
  "scripts": {
    "baseline:check": "node scripts/verify-upstream-baseline.mjs",
    "build": "vite build && node scripts/build.js",
    "build:zip": "vite build && node scripts/build.js --zip",
    "build:alpha": "vite build && node scripts/build.js --alpha",
    "test": "vite build && node scripts/build.js --test && node tests/serve.js",
    "test:characterization": "node tests/characterization/run-non-ai-contracts.mjs",
    "test:fixtures": "node tests/characterization/replay-fixtures.mjs",
    "test:browser": "node tests/run-browser-mocha.mjs",
    "test:ai": "vitest run --config vitest.ai.config.ts",
    "typecheck:ai": "tsc --project tsconfig.ai.json",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "visual:serve": "vite --config vite.visual.config.js",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/x-charts": "^8.28.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/node": "22.20.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "mime-types": "^3.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
